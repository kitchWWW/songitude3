<?xml version="1.0" encoding="utf-8"?>
<!-- The toy-piano favicon, as an adaptive icon. The foreground is the iOS tile at 62% so the piano
     survives a circular mask; the background is the same picture, filled and blurred, so whatever
     the mask leaves showing around it is the painting's own colours rather than a hard edge. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
